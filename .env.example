# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Verified sender on your Resend domain, e.g. "Portfolio <contact@yourdomain.com>"
RESEND_FROM=Portfolio Contact <contact@yourdomain.com>

# Inbox that receives form submissions
CONTACT_TO=you@example.com

# Optional: comma-separated extra allowed browser origins (custom domains)
# ALLOWED_ORIGINS=https://aemine.dev,https://www.aemine.dev

# Upstash Redis — durable rate limiting across serverless instances
# Create a free DB at https://upstash.com and paste REST credentials
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...
