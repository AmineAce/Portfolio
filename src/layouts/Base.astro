---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Frontend developer based in Casablanca, building precise, performant interfaces that feel as good as they look.', ogImage } = Astro.props;
const canonicalURL = Astro.url;
const siteUrl = 'https://aemine.vercel.app';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Amine',
  url: siteUrl,
  jobTitle: 'Frontend Developer',
  sameAs: [
    'https://github.com/AmineAce',
    'https://linkedin.com/in/amineace',
    'https://twitter.com/amineace'
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Meta Description -->
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Font loading via Astro Fonts API -->
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-instrument-serif" preload />
  </head>
  <body>
    <a href="#hero" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-surface-900 focus:text-surface-50 focus:px-4 focus:py-2 focus:rounded-input">Skip to content</a>
    <div id="scroll-bar" role="progressbar" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100} aria-label="Page scroll progress"></div>
    <Navbar />
    <main role="main">
      <slot />
    </main>
    <Footer />

    <script is:inline src="/scripts/scroll-progress.js"></script>
    <SpeedInsights />
    <Analytics />
  </body>
</html>