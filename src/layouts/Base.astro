---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schemas?: Array<Record<string, unknown>>;
}

const { title, description = 'Frontend developer based in Casablanca, building precise, performant interfaces that feel as good as they look.', ogImage, schemas = [] } = Astro.props;
const canonicalURL = Astro.url;
const siteUrl = 'https://aemine.vercel.app';

const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@id': `${siteUrl}/#person`,
    '@type': 'Person',
    name: 'Amine E.',
    alternateName: 'AmineAce',
    url: siteUrl,
    jobTitle: 'Frontend Developer',
    sameAs: [
      'https://github.com/AmineAce',
      'https://linkedin.com/in/amineace',
      'https://twitter.com/amineace'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@id': `${siteUrl}/#website`,
    '@type': 'WebSite',
    name: 'Amine - Frontend Developer',
    url: siteUrl,
    about: { '@id': `${siteUrl}/#person` },
  },
];
const allSchemas = [...baseSchemas, ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
      <link rel="icon" href="/favicon.ico" sizes="32x32" />
      <link rel="manifest" href="/site.webmanifest" />
      <meta name="robots" content="index, follow" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Meta Description -->
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Structured Data (JSON-LD) -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <!-- Font loading via Astro Fonts API -->
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-instrument-serif" preload />
      <style is:global>
        @keyframes starfield-twinkle {
          from { opacity: 0.15; }
          to { opacity: 0.75; }
        }
      </style>
    </head>
  <body>
    <div id="starfield" aria-hidden="true"></div>
    <a href="#hero" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-surface-900 focus:text-surface-50 focus:px-4 focus:py-2 focus:rounded-input">Skip to content</a>
    <div id="scroll-bar" role="progressbar" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100} aria-label="Page scroll progress">
      <div id="scroll-bar-fill"></div>
      </div>
    <Navbar />
    <main role="main">
      <slot />
    </main>
    <Footer />

    <script>
      (function () {
        var ro = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        function observe() { document.querySelectorAll('.reveal, .reveal-scale, .reveal-stagger').forEach(function (el) { ro.observe(el); }); }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', observe); else observe();
        document.addEventListener('astro:page-load', observe);
      })();

      (function () {
        var fill = document.getElementById('scroll-bar-fill');
        var bar = document.getElementById('scroll-bar');
        if (!fill || !bar) return;

        var ticking = false;

        function getProgress() {
            var scrollTop = window.scrollY;
          var docHeight = document.documentElement.scrollHeight;
          var winHeight = window.innerHeight;
          var scrollable = docHeight - winHeight;
          return scrollable > 0 ? Math.min(scrollTop / scrollable, 1) : 0;
          }

        function update() {
            if (!fill || !bar) return;
              var progress = getProgress();
          fill.style.transform = 'scaleX(' + progress + ')';
          bar.setAttribute('aria-valuenow', Math.round(progress * 100).toString());
          }

          function onScroll() {
            if (!ticking) {
              requestAnimationFrame(function () {
                update();
                ticking = false;
            });
              ticking = true;
          }
          }

        window.addEventListener('scroll', onScroll, { passive: true });
        update();
        })();

      (function () {
        var sf = document.getElementById('starfield');
        if (!sf || sf.dataset.ready) return;
        sf.dataset.ready = '1';
        var mrm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var sizes = [0.8,0.9,1,1.1,1.2,1.3,1.4,1.5];
        var pos = [
          {x:8.8,y:7.5},{x:21.2,y:4.7},{x:37.5,y:9.2},{x:55,y:4.2},{x:77.5,y:6.7},{x:90,y:10.8},{x:95,y:20},{x:6.2,y:21.7},{x:13.8,y:15},{x:86.2,y:15.8},{x:93.8,y:29.2},{x:7.5,y:33.3},{x:12.5,y:45},{x:92.5,y:41.7},{x:87.5,y:53.3},{x:8.8,y:58.3},{x:15,y:68.3},{x:92.5,y:66.7},{x:85,y:78.3},{x:6.2,y:80},{x:11.2,y:90},{x:90,y:91.7},{x:95,y:85},{x:32.5,y:93.3},{x:67.5,y:95},{x:23.8,y:83.3},{x:80,y:88.3},{x:41.2,y:2.5},{x:70,y:96.7},{x:5,y:51.7},{x:96.2,y:31.7},{x:27.5,y:96.7},{x:10,y:76.7},{x:91.2,y:21.7},{x:47.5,y:96.7},{x:3.8,y:70},{x:97.5,y:50},{x:2.5,y:35},{x:17.5,y:95},{x:85,y:5},{x:5.8,y:88.3},{x:93.8,y:75},{x:32.5,y:2.5},{x:67.5,y:3.3},{x:3.8,y:45},{x:96.2,y:58.3},{x:26.2,y:12.5},{x:72.5,y:13.3},{x:45,y:3.3},{x:50,y:8.3},{x:60,y:5},{x:38.8,y:20},{x:62.5,y:21.7},{x:30,y:30},{x:70,y:31.7},{x:38.8,y:41.7},{x:62.5,y:43.3},{x:30,y:55},{x:70,y:56.7},{x:38.8,y:66.7},{x:62.5,y:68.3},{x:27.5,y:78.3},{x:72.5,y:80},{x:45,y:86.7},{x:55,y:88.3},{x:5,y:10},{x:95,y:10},{x:5,y:90},{x:95,y:90},{x:12.5,y:3.3},{x:87.5,y:3.3},{x:2.5,y:83.3},{x:97.5,y:83.3},{x:15,y:50},{x:85,y:35},{x:35,y:75},{x:65,y:27.5},{x:45,y:47.5},{x:55,y:52.5},{x:20,y:60},{x:80,y:45},{x:12.5,y:28.3},{x:87.5,y:62.5},{x:42.5,y:15},{x:57.5,y:73.3},{x:18.8,y:72.5},{x:81.2,y:23.3},{x:25,y:42.5},{x:75,y:48.3},{x:15,y:38.3},{x:85,y:72.5},{x:22.5,y:88.3},{x:77.5,y:87.5},{x:25,y:5},{x:75,y:7.5},{x:35,y:12.5},{x:65,y:16.7},{x:30,y:25},{x:70,y:26.7},{x:28.8,y:35},{x:71.2,y:36.7},{x:32.5,y:48.3},{x:67.5,y:50},{x:33.8,y:60},{x:66.2,y:61.7},{x:30,y:70},{x:70,y:71.7},{x:35,y:82.5},{x:65,y:85},{x:40,y:92.5},{x:60,y:93.3}
        ];
        pos.forEach((p, i) => {
          if (!sf) return;
          var dot = document.createElement('div');
          var s = sizes[i % sizes.length];
          dot.style.cssText = 'position:absolute;left:'+p.x+'%;top:'+p.y+'%;width:'+s+'px;height:'+s+'px;border-radius:50%;background:#e4e4e7';
            if (!mrm) {
            dot.style.animation = 'starfield-twinkle 3s ease-in-out infinite alternate';
            var delays = [0,-1,-0.5,-1.5,-0.3,-0.8,-1.8,-0.2];
              dot.style.animationDelay = delays[i % delays.length]+'s';
            } else {
              dot.style.opacity = '0.35';
          }
            sf.appendChild(dot);
        });
      })();
    </script>
    <SpeedInsights />
    <Analytics />
  </body>
</html>