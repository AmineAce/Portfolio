---
import Brand from './Brand.astro';

const navLinks = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<style>
  [data-menu-open] [data-bar="1"] {
    transform: translateY(5.5px) rotate(45deg);
  }
  [data-menu-open] [data-bar="2"] {
    opacity: 0;
  }
  [data-menu-open] [data-bar="3"] {
    transform: translateY(-5.5px) rotate(-45deg);
  }
  #navbar.scrolled {
    background: oklch(7% 0.02 270 / 0.85);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    border-bottom: 1px solid oklch(20% 0.02 270 / 0.6);
  }
  [data-nav-link]::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 40%;
    height: 1.5px;
    background: #6366f1;
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 1px;
  }
  [data-nav-link]:hover::after,
  [data-nav-link].active::after {
    transform: translateX(-50%) scaleX(1);
  }
</style>

<nav id="navbar" class="fixed top-0 w-full z-50 transition-colors duration-base ease-expo-out">
  <div class="relative mx-auto flex h-16 max-w-[1100px] items-center justify-between px-6">
    <Brand href="/" />

    <div class="absolute left-1/2 hidden -translate-x-1/2 rounded-pill border border-surface-800/60 bg-surface-900/40 backdrop-blur-sm py-1.5 px-2 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link
          class="relative rounded-pill px-4 py-2 text-sm text-surface-400 transition-colors duration-base ease-expo-out hover:bg-accent/15 hover:text-accent active:scale-95"
        >
          {link.label}
        </a>
      ))}
    </div>

    <button id="menu-toggle" class="flex flex-col items-center gap-1 md:hidden focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 active:scale-95 transition-transform duration-micro" aria-label="Open navigation menu">
      <div data-bar="1" class="h-[1.5px] w-[18px] bg-surface-400 transition-all duration-base ease-expo-out"></div>
      <div data-bar="2" class="h-[1.5px] w-[18px] bg-surface-400 transition-all duration-base ease-expo-out"></div>
      <div data-bar="3" class="h-[1.5px] w-[18px] bg-surface-400 transition-all duration-base ease-expo-out"></div>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="fixed inset-0 z-[60] hidden flex-col bg-surface-black/95 backdrop-blur-xl" style="transition: opacity 0.2s ease-out;">
  <div class="flex justify-end px-6 pt-6">
    <button id="menu-close" class="text-surface-400 text-2xl leading-none focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2" aria-label="Close navigation menu">&times;</button>
  </div>
  <div class="flex flex-1 flex-col items-center justify-center gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-nav-link-mobile
        class="text-2xl text-surface-400 transition-all duration-base ease-expo-out hover:text-accent active:scale-95"
          style="transition: opacity 0.25s ease-out, transform 0.25s ease-out;"
        >
          {link.label}
        </a>
      ))}
  </div>
</div>

<script>
  (function () {
    var navbar = document.getElementById('navbar');
      var menuToggle = document.getElementById('menu-toggle');
    var menuClose = document.getElementById('menu-close');
    var mobileMenu = document.getElementById('mobile-menu');
    var navLinks = document.querySelectorAll('[data-nav-link]');
    var mobileNavLinks = document.querySelectorAll('[data-nav-link-mobile]');
    var sectionIds = ['work', 'about', 'contact'];
    var isMenuOpen = false;

    function onScroll() {
      if (!navbar) return;
        var threshold = navbar.offsetHeight;
      if (window.scrollY > threshold) {
          navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
      }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    function setActiveLink(activeLink) {
      navLinks.forEach(function (link) {
          link.classList.remove('bg-accent/15', 'text-accent');
      });
        if (activeLink) {
          activeLink.classList.add('bg-accent/15', 'text-accent');
      }
      }

    var observer = new IntersectionObserver(
      function (entries) {
          for (var i = 0; i < entries.length; i++) {
            var entry = entries[i];
            if (entry.isIntersecting) {
              var id = entry.target.id;
              var link = document.querySelector('[data-nav-link][href$="#' + id + '"]');
            if (link) setActiveLink(link);
            }
          }
        },
        { threshold: 0.6 }
      );

    function observeSections() {
      sectionIds.forEach(function (id) {
          var el = document.getElementById(id);
          if (el) observer.observe(el);
        });
      }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observeSections);
    } else {
      observeSections();
    }

    function openMenu() {
      if (isMenuOpen) return;
        isMenuOpen = true;

      mobileNavLinks.forEach(function (link) {
        link.classList.remove('bg-accent/15', 'text-accent');
      });

      mobileMenu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      menuToggle.setAttribute('data-menu-open', '');
      menuToggle.setAttribute('aria-label', 'Close navigation menu');

      var links = mobileMenu.querySelectorAll('a');
      links.forEach(function (link, i) {
          link.style.opacity = '0';
        link.style.transform = 'translateY(12px)';
          setTimeout(function () {
            link.style.opacity = '1';
            link.style.transform = 'translateY(0)';
          }, i * 60);
        });
    }

      function closeMenu() {
      if (!isMenuOpen) return;
      isMenuOpen = false;

      menuToggle.removeAttribute('data-menu-open');
      menuToggle.setAttribute('aria-label', 'Open navigation menu');
      document.body.style.overflow = '';

        mobileMenu.style.opacity = '0';
        setTimeout(function () {
        mobileMenu.classList.add('hidden');
          mobileMenu.style.opacity = '';
          var links = mobileMenu.querySelectorAll('a');
        links.forEach(function (link) {
            link.style.opacity = '';
            link.style.transform = '';
        });
        }, 200);
      }

    if (menuToggle && mobileMenu) {
        menuToggle.addEventListener('click', openMenu);
      }

    if (menuClose) {
        menuClose.addEventListener('click', closeMenu);
      }

      mobileNavLinks.forEach(function (link) {
        link.addEventListener('click', closeMenu);
    });
  })();
</script>
