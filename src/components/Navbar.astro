---
import Brand from './Brand.astro';

const navLinks = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<style>
  [data-menu-open] [data-bar="1"] {
    transform: translateY(5.5px) rotate(45deg);
  }
  [data-menu-open] [data-bar="2"] {
    opacity: 0;
  }
  [data-menu-open] [data-bar="3"] {
    transform: translateY(-5.5px) rotate(-45deg);
  }
</style>

<nav id="navbar" class="fixed top-0 w-full z-50 bg-transparent transition-colors duration-base ease-expo-out">
  <!-- Container -->
  <div class="relative mx-auto flex h-16 max-w-[1100px] items-center justify-between px-6">
    <!-- Logo -->
    <Brand href="/" />

    <!-- Desktop Pill Navigation -->
    <div class="absolute left-1/2 hidden -translate-x-1/2 rounded-pill border border-surface-800 bg-surface-900 py-1.5 px-2 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link
          class="rounded-pill px-4 py-2 text-sm text-surface-400 hover:bg-accent/20 hover:text-accent transition-colors duration-base ease-expo-out"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile Menu Toggle -->
    <button id="menu-toggle" class="flex flex-col items-center gap-1 md:hidden focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2" aria-label="Open navigation menu">
      <div data-bar="1" class="h-[1.5px] w-[18px] bg-surface-400 transition-all duration-base ease-expo-out"></div>
      <div data-bar="2" class="h-[1.5px] w-[18px] bg-surface-400 transition-all duration-base ease-expo-out"></div>
      <div data-bar="3" class="h-[1.5px] w-[18px] bg-surface-400 transition-all duration-base ease-expo-out"></div>
    </button>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-[60] hidden flex-col bg-surface-black">
  <div class="flex justify-end px-6 pt-6">
    <button id="menu-close" class="text-surface-400 text-2xl leading-none focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2" aria-label="Close navigation menu">&times;</button>
  </div>
  <div class="flex flex-1 flex-col items-center justify-center gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-nav-link-mobile
        class="text-2xl text-surface-400 transition-colors duration-base ease-expo-out hover:text-accent"
      >
        {link.label}
      </a>
    ))}
  </div>
</div>

<script>
  import { animate } from 'motion';

  (function () {
    var navbar = document.getElementById('navbar');
    var menuToggle = document.getElementById('menu-toggle');
    var menuClose = document.getElementById('menu-close');
    var mobileMenu = document.getElementById('mobile-menu');
    var navLinks = document.querySelectorAll('[data-nav-link]');
    var mobileNavLinks = document.querySelectorAll('[data-nav-link-mobile]');
    var sectionIds = ['work', 'about', 'contact'];
    var isMenuOpen = false;

    function onScroll() {
      if (!navbar) return;
      var threshold = navbar.offsetHeight;
      if (window.scrollY > threshold) {
        navbar.classList.add('bg-surface-black/80', 'backdrop-blur-md', 'border-b', 'border-surface-800');
      } else {
        navbar.classList.remove('bg-surface-black/80', 'backdrop-blur-md', 'border-b', 'border-surface-800');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    function setActiveLink(activeLink) {
      // Only track active state on desktop nav links, not mobile links
        navLinks.forEach(function (link) {
          link.classList.remove('bg-accent/20', 'text-accent');
      });
        if (activeLink) {
          activeLink.classList.add('bg-accent/20', 'text-accent');
        }
    }

    var observer = new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          var entry = entries[i];
          if (entry.isIntersecting) {
            var id = entry.target.id;
            var link = document.querySelector('[data-nav-link][href="#' + id + '"]');
            if (link) setActiveLink(link);
            }
          }
        },
        { threshold: 0.6 }
      );

    function observeSections() {
      sectionIds.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observeSections);
    } else {
      observeSections();
    }

    function openMenu() {
      if (isMenuOpen) return;
      isMenuOpen = true;

      // Clear any stale active state on mobile links
      mobileNavLinks.forEach(function (link) {
        link.classList.remove('bg-accent/20', 'text-accent');
      });

      mobileMenu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      menuToggle.setAttribute('data-menu-open', '');
      menuToggle.setAttribute('aria-label', 'Close navigation menu');

      animate(mobileMenu, { opacity: [0, 1] }, { duration: 0.2, easing: [0.16, 1, 0.3, 1] });

      var links = mobileMenu.querySelectorAll('a');
      links.forEach(function (link, i) {
        animate(link, { opacity: [0, 1], y: [12, 0] }, { duration: 0.3, delay: i * 0.06, easing: [0.16, 1, 0.3, 1] });
      });
    }

    function closeMenu() {
      if (!isMenuOpen) return;
      isMenuOpen = false;

      menuToggle.removeAttribute('data-menu-open');
      menuToggle.setAttribute('aria-label', 'Open navigation menu');
      document.body.style.overflow = '';

      animate(mobileMenu, { opacity: [1, 0] }, { duration: 0.15, easing: [0.16, 1, 0.3, 1] }).finished.then(function () {
        mobileMenu.classList.add('hidden');
        var links = mobileMenu.querySelectorAll('a');
        links.forEach(function (link) {
          link.style.opacity = '';
          link.style.transform = '';
        });
      });
    }

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', openMenu);
    }

    if (menuClose) {
      menuClose.addEventListener('click', closeMenu);
    }

    mobileNavLinks.forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>