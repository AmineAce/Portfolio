---
import Brand from './Brand.astro';
import { Icon } from 'astro-icon/components';
---

<footer class="border-t border-surface-900 py-10">
  <div class="max-w-[1100px] mx-auto px-6 flex justify-between items-center">
    <Brand size="xs" muted />
    <div class="flex items-center gap-3 text-xs text-surface-500">
      <span class="inline-flex items-center gap-1.5 cursor-default select-none transition-colors duration-micro hover:text-accent">
        <Icon name="simple-icons:astro" size="14" /><span>Astro 7</span>
      </span>
      <span class="text-surface-700 select-none" aria-hidden="true">/</span>
      <span class="inline-flex items-center gap-1.5 cursor-default select-none transition-colors duration-micro hover:text-accent">
        <Icon name="simple-icons:vite" size="14" /><span>Vite 8</span>
      </span>
      <span class="text-surface-700 select-none" aria-hidden="true">/</span>
      <span class="inline-flex items-center gap-1.5 cursor-default select-none transition-colors duration-micro hover:text-accent">
        <Icon name="simple-icons:tailwindcss" size="14" /><span>Tailwind 4</span>
      </span>
      <span class="text-surface-700 select-none" aria-hidden="true">/</span>
      <span class="inline-flex items-center gap-1.5 cursor-default select-none transition-colors duration-micro hover:text-accent">
        <Icon name="simple-icons:typescript" size="14" /><span>TS 6</span>
      </span>
      <span class="text-surface-700 select-none" aria-hidden="true">/</span>
      <span class="inline-flex items-center gap-1.5 cursor-default select-none transition-colors duration-micro hover:text-accent">
        <Icon name="simple-icons:vercel" size="14" /><span>Vercel</span>
      </span>
    </div>
  </div>
</footer>
