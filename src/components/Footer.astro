---
import Brand from './Brand.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-900 py-10">
  <div class="max-w-[1100px] mx-auto px-6 flex justify-between items-center">
    <Brand size="xs" muted />
    <div class="flex items-center gap-4 text-xs text-surface-600">
      <a href="https://github.com/AmineAce" target="_blank" rel="noopener noreferrer" class="transition-all duration-base ease-expo-out hover:text-accent hover:scale-105">GitHub</a>
      <span aria-hidden="true">&middot;</span>
      <span>Built with Astro &middot; {year}</span>
    </div>
  </div>
</footer>
