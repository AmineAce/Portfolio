---
import Brand from './Brand.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-900 py-8 mt-0">
  <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
    <Brand size="xs" muted />
    <span class="text-xs text-surface-400">Built with Astro · {year}</span>
  </div>
</footer>