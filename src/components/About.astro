---
import { Icon } from 'astro-icon/components';
---

<section id="about" class="max-w-[1100px] mx-auto px-6 py-24">
  <div class="mb-16 reveal">
    <p class="text-xs text-accent-ondark font-medium tracking-widest uppercase mb-3">
      About Me
    </p>
    <h2 class="text-4xl font-medium text-surface-200 tracking-tight">
      A little context.
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
    <div class="md:col-span-3 reveal">
      <div class="bg-surface-900/70 border border-surface-800 rounded-card p-8 flex flex-col h-full">
        <div class="text-xs text-accent-ondark tracking-widest uppercase mb-6">
          Who I am
        </div>
        <h3 class="font-serif italic text-2xl text-surface-white leading-snug tracking-tight mb-6">
          I build for the web.
        </h3>
        <p class="text-surface-400 text-sm leading-relaxed">
          Frontend developer focused on clean interfaces, thoughtful interactions, and code that ships. I explore the edges of what AI makes possible in development, then bring that back into real products: debugging and polishing until the experience feels alive.
        </p>
        <div class="flex-1"></div>
        <div class="pt-6 border-t border-surface-800 mt-6">
          <div class="text-xs text-surface-500 tracking-widest uppercase mb-3">
            Current stack
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-pill text-xs bg-accent/5 border border-accent/30 text-accent-ondark">Astro</span>
            <span class="px-3 py-1 rounded-pill text-xs bg-accent/5 border border-accent/30 text-accent-ondark">TypeScript</span>
            <span class="px-3 py-1 rounded-pill text-xs bg-accent/5 border border-accent/30 text-accent-ondark">React</span>
            <span class="px-3 py-1 rounded-pill text-xs bg-accent/5 border border-accent/30 text-accent-ondark">JavaScript</span>
            <span class="px-3 py-1 rounded-pill text-xs bg-surface-800 text-surface-400">Tailwind CSS</span>
            <span class="px-3 py-1 rounded-pill text-xs bg-surface-800 text-surface-400">Git</span>
            <span class="px-3 py-1 rounded-pill text-xs bg-surface-800 text-surface-400">Vercel</span>
          </div>
        </div>
      </div>
    </div>

    <div class="md:col-span-2 flex flex-col gap-4 reveal-stagger">
      <div class="bg-surface-900/70 border border-surface-800 rounded-card p-5">
        <div class="text-accent-ondark mb-3">
          <Icon name="tabler:map-pin" size="20" />
        </div>
        <div class="text-xs text-surface-500 tracking-widest uppercase mb-1">
          Location
        </div>
        <div class="text-sm text-surface-300">
          Morocco &middot; Remote worldwide
        </div>
      </div>

      <div class="bg-surface-900/70 border border-surface-800 rounded-card p-5">
        <div class="text-accent-ondark mb-3">
          <Icon name="tabler:code" size="20" />
        </div>
        <div class="text-xs text-surface-500 tracking-widest uppercase mb-1">
          Currently
        </div>
        <ul class="space-y-2 mt-3">
          <li class="flex items-center gap-2.5 text-xs text-surface-400">
            <span class="w-1 h-1 rounded-full bg-accent shrink-0"></span>
            Building a SaaS platform for media professionals
          </li>
          <li class="flex items-center gap-2.5 text-xs text-surface-400">
            <span class="w-1 h-1 rounded-full bg-accent shrink-0"></span>
            Deepening my design & animation craft
          </li>
          <li class="flex items-center gap-2.5 text-xs text-surface-400">
            <span class="w-1 h-1 rounded-full bg-accent shrink-0"></span>
            Open to new opportunities
          </li>
        </ul>
      </div>

      <div class="bg-surface-900/70 border border-surface-800 rounded-card p-5">
        <div class="text-accent-ondark mb-3">
          <Icon name="tabler:book" size="20" />
        </div>
        <div class="text-xs text-surface-500 tracking-widest uppercase mb-1">
          Background
        </div>
        <div class="text-sm text-surface-300 leading-relaxed">
          Self-taught frontend dev &middot; B.A. in English &middot; TESOL diploma
        </div>
      </div>
    </div>
  </div>
</section>
