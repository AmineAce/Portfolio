---
import { ContactForm } from '../components/ContactForm.tsx';
---

<section id="contact" class="max-w-[1100px] mx-auto px-6 py-24">
  <div class="border border-surface-800 rounded-card max-w-[500px] mx-auto mb-4 bg-surface-900/50 reveal-scale">
    <div class="flex items-center justify-center gap-6 py-4 px-6">
      <a
        href="https://github.com/AmineAce"
        target="_blank"
        class="text-xs text-surface-500 transition-all duration-base ease-expo-out hover:text-accent hover:scale-105 tracking-wider uppercase"
      >
        GitHub
      </a>
      <span class="text-surface-700 select-none text-xs">/</span>
      <a
        href="https://x.com/_AMINEACE"
        target="_blank"
        class="text-xs text-surface-500 transition-all duration-base ease-expo-out hover:text-accent hover:scale-105 tracking-wider uppercase"
      >
        X
      </a>
    </div>
  </div>

  <div class="border border-surface-800 rounded-card overflow-hidden relative max-w-[500px] mx-auto bg-surface-900/50 reveal">
    <div class="relative min-h-[600px] flex flex-col justify-center px-6">
      <ContactForm client:idle endpoint="/api/contact" />

    </div>
  </div>


</section>
