<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
  }
</style>

<section id="contact" class="max-w-[1100px] mx-auto px-6 py-24">
  <div data-reveal="contact-social" class="bg-surface-900 border border-surface-800 rounded-card max-w-[500px] mx-auto mb-4">
    <div class="flex items-center justify-center gap-6 py-4 px-6">
      <a
        href="https://github.com/AmineAce"
        target="_blank"
        class="text-xs text-surface-500 hover:text-accent transition-colors duration-base tracking-wider uppercase"
      >
        GitHub
      </a>
      <span class="text-surface-700 select-none text-xs">/</span>
      <a
        href="https://x.com/_AMINEACE"
        target="_blank"
        class="text-xs text-surface-500 hover:text-accent transition-colors duration-base tracking-wider uppercase"
      >
        X
      </a>
    </div>
  </div>

  <div data-reveal="contact-card" class="bg-surface-900 border border-surface-800 rounded-card overflow-hidden relative max-w-[500px] mx-auto">
    <div class="relative min-h-[600px] flex flex-col justify-center px-6">
      <div class="text-center mb-8">
        <h2 class="font-serif italic text-3xl md:text-4xl text-surface-white tracking-tight leading-tight mb-3">
          Let's work together.
        </h2>
        <p class="text-surface-400 text-sm leading-relaxed max-w-xs mx-auto">
          Send me a message and I'll get back to you as soon as possible.
        </p>
      </div>

      <form id="contact-form" class="text-left space-y-5">
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] top-0 h-0 w-0 opacity-0 pointer-events-none overflow-hidden"
        />
        <div class="group">
          <label for="name" class="block text-xs text-surface-500 tracking-widest uppercase mb-2 transition-colors duration-micro group-focus-within:text-accent">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full bg-surface-950/80 border border-surface-800 rounded-input px-4 py-3 text-sm text-surface-200 placeholder-surface-600/60 outline-none transition-all duration-base ease-expo-out focus:border-accent/60 focus:bg-surface-950 focus:shadow-[0_0_20px_-8px] focus:shadow-accent/20"
            placeholder="Your name"
          />
        </div>

        <div class="group">
          <label for="email" class="block text-xs text-surface-500 tracking-widest uppercase mb-2 transition-colors duration-micro group-focus-within:text-accent">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full bg-surface-950/80 border border-surface-800 rounded-input px-4 py-3 text-sm text-surface-200 placeholder-surface-600/60 outline-none transition-all duration-base ease-expo-out focus:border-accent/60 focus:bg-surface-950 focus:shadow-[0_0_20px_-8px] focus:shadow-accent/20"
            placeholder="your@email.com"
          />
        </div>

        <div class="group">
          <label for="message" class="block text-xs text-surface-500 tracking-widest uppercase mb-2 transition-colors duration-micro group-focus-within:text-accent">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="4"
            class="w-full bg-surface-950/80 border border-surface-800 rounded-input px-4 py-3 text-sm text-surface-200 placeholder-surface-600/60 outline-none transition-all duration-base ease-expo-out focus:border-accent/60 focus:bg-surface-950 focus:shadow-[0_0_20px_-8px] focus:shadow-accent/20 resize-none"
            placeholder="What's on your mind?"
          ></textarea>
        </div>

        <div id="form-error" class="text-xs text-red-400/90 hidden text-center" role="alert"></div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full rounded-input bg-surface-white text-surface-black font-medium px-6 py-3 text-sm border border-surface-white transition-all duration-base ease-expo-out hover:bg-accent hover:text-surface-white hover:border-accent hover:shadow-[0_0_24px_-8px] hover:shadow-accent/40 active:scale-[0.98]"
        >
          Send Message
        </button>
      </form>

      <div id="form-success" class="hidden">
        <div class="flex items-center justify-center gap-2 text-sm text-surface-400">
          <span class="text-accent text-base">&#10003;</span>
          Thanks! I'll get back to you soon.
        </div>
      </div>

    </div>
  </div>

  <script>
    import { animate, inView } from 'motion';

    const initReveal = () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const cards = document.querySelectorAll('[data-reveal]') as NodeListOf<HTMLElement>;

      if (prefersReducedMotion) {
        cards.forEach((el) => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
        return;
      }

      cards.forEach((el, i) => {
        inView(
          el,
          () => {
            (animate as any)(
              el,
              { opacity: [0, 1], y: [24, 0] },
              { duration: 0.6, delay: i * 0.1, easing: [0.16, 1, 0.3, 1] }
            );
          },
          { threshold: 0.15 } as any
        );
      });
    };

    const runInit = () => {
      if (!(window as any).__contactRevealInitialized) {
        (window as any).__contactRevealInitialized = true;
        initReveal();
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runInit);
    } else {
      runInit();
    }

    document.addEventListener('astro:page-load', runInit);
  </script>

  <script is:inline src="/scripts/contact-form.js"></script>
</section>
