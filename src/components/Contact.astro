---
import { ContactForm } from '../components/ContactForm.tsx';
---

<section id="contact" class="max-w-[1100px] mx-auto px-6 py-24">
  <div class="grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-12 items-stretch">

    <!-- Right: Sidebar (2/5) — rendered first for mobile ordering -->
    <div class="md:col-span-2 md:order-2 flex">
      <div class="flex-1 border border-surface-800 rounded-card bg-surface-900/50 p-8 reveal" style="animation-delay: 0.15s;">
        <h3 class="font-serif italic text-3xl text-surface-50 mb-4">
          Let's build something
        </h3>
        <p class="text-surface-400 text-sm leading-relaxed mb-4">
          I'm always excited to hear about interesting projects, collaborations, or just chat about frontend, AI tools, or web craftsmanship.
        </p>
        <p class="text-surface-400 text-sm leading-relaxed mb-6">
          Whether it's a SaaS, a wild interactive experience, or just feedback — drop me a line.
        </p>
        <div class="flex items-center gap-4 mb-8">
          <a href="https://github.com/AmineAce" target="_blank" rel="noopener noreferrer"
             class="text-xs text-surface-500 tracking-wider uppercase transition-all duration-base ease-expo-out hover:text-accent hover:scale-105 border-b-[3px] border-accent/30 pb-0.5 hover:border-accent/80">GitHub</a>
          <span class="text-surface-700 select-none text-xs">/</span>
          <a href="https://x.com/_AMINEACE" target="_blank" rel="noopener noreferrer"
             class="text-xs text-surface-500 tracking-wider uppercase transition-all duration-base ease-expo-out hover:text-accent hover:scale-105 border-b-[3px] border-accent/30 pb-0.5 hover:border-accent/80">X</a>
        </div>
        <div class="border-t border-surface-800 pt-5">
          <span class="text-xs text-surface-600">
            Response time <span class="text-surface-400 font-medium">— I usually reply within 48 hours</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Left: Form (3/5) — rendered second for mobile ordering -->
    <div class="md:col-span-3 md:order-1 flex">
      <div class="flex-1 border border-surface-800 rounded-card overflow-hidden bg-surface-900/50 reveal">
        <div class="relative px-6 py-12">
          <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
               style="background-image: radial-gradient(#e4e4e7 0.5px, transparent 0.5px); background-size: 20px 20px;"></div>
          <ContactForm client:idle endpoint="/api/contact" />
        </div>
      </div>
    </div>

  </div>
</section>
