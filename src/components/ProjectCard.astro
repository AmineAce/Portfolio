---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;

const { title, description, tags, liveUrl, githubUrl, image } = entry.data;
const slug = entry.id;
const caseStudyUrl = slug ? `/work/${slug}` : undefined;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-card border border-surface-800 bg-surface-900/70 transition-all duration-base ease-expo-out hover:-translate-y-2 hover:border-accent/30 hover:shadow-[0_12px_40px_-12px] hover:shadow-accent/15"
>
  {caseStudyUrl && (
    <a
      href={caseStudyUrl}
      class="absolute inset-0 z-10"
      aria-label={`Read case study: ${title}`}
    ></a>
  )}
  <div class="h-[180px]" style="background-color: var(--color-surface-950);">
    {image ? (
      <div class="w-full h-full p-3">
        <div class="w-full h-full rounded-card overflow-hidden bg-surface-950">
          <picture>
            <source srcset={image.replace('.webp', '.avif')} type="image/avif" />
            <source srcset={image} type="image/webp" />
            <img
                src={image.replace('.webp', '.png')}
                alt={title}
                class="w-full h-full object-cover object-top transition-transform duration-base ease-expo-out group-hover:scale-105"
                loading="lazy"
            />
          </picture>
        </div>
      </div>
    ) : (
      <div
        class="mx-auto w-4/5 h-3/4 mt-4 rounded-card border border-surface-800 bg-surface-900/70 flex flex-col items-center justify-center"
      >
        <div class="flex gap-1.5 self-start ml-4 mt-3">
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
        </div>
        <span class="mt-8 text-xs text-surface-500">Preview on hover</span>
      </div>
    )}
  </div>

  <div class="p-5 flex flex-col flex-1">
    <div class="flex justify-start items-center mb-3">
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span
            class="px-3 py-1 rounded-pill text-xs bg-surface-800 text-surface-400 border border-surface-700/50"
          >
            {tag}
          </span>
        ))}
      </div>
    </div>

    <h3
      class="text-lg font-medium tracking-tight text-surface-200 leading-snug mb-2 group-hover:text-surface-white transition-colors duration-micro"
    >
      {title}
    </h3>

    <p class="text-sm leading-relaxed text-surface-500 mb-5 flex-1">
      {description}
    </p>

    <div class="flex justify-between items-center mt-auto">
      <div class="flex gap-2">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            aria-label={`${title} source code on GitHub`}
              class="relative z-20 px-3 py-1 rounded-input border border-surface-700/50 text-surface-400 transition-all duration-base ease-expo-out hover:border-accent hover:text-accent hover:bg-accent/5 active:scale-95 text-sm"
            >
              Github
            </a>
        )}
          {liveUrl && (
            <a
            href={liveUrl}
            target="_blank"
            aria-label={`${title} live website`}
              class="relative z-20 px-3 py-1 rounded-input border border-surface-700/50 text-surface-400 transition-all duration-base ease-expo-out hover:border-accent hover:text-accent hover:bg-accent/5 active:scale-95 text-sm"
            >
              Live site
            </a>
        )}
      </div>
    </div>
  </div>
</article>
