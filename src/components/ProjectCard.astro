---
import type { CollectionEntry } from 'astro:content';

interface ProjectData {
  title: string;
  description?: string;
  tags?: string[];
  year?: number;
  featured?: boolean;
  liveUrl?: string;
  githubUrl?: string;
  order?: number;
  coverColor?: string;
  image?: string;
  slug?: string;
}

interface Props {
  entry?: CollectionEntry<'projects'> | ProjectData;
  }

const { entry } = Astro.props;

// Extract data safely: support full CollectionEntry or plain data object
const data: ProjectData = entry && 'data' in entry ? entry.data : (entry as ProjectData) || {};

const {
  title = '',
  description = '',
  tags = [],
  liveUrl,
  githubUrl,
  image,
} = data;

// Slug for case study URL — CollectionEntry has .slug; plain data may have .id or .slug
const slug = entry && 'id' in entry ? entry.id : (entry as ProjectData)?.slug || '';
const caseStudyUrl = slug ? `/work/${slug}` : undefined;

// Order display with fallback

---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-card border border-surface-800 bg-surface-900 transition-colors duration-base ease-expo-out"
>
  <!-- Card Image Area -->
  <div class="h-[180px]" style="background-color: var(--color-surface-950);">
    {image ? (
      <div class="w-full h-full p-3">
        <div class="w-full h-full rounded-card overflow-hidden bg-surface-950">
          <img 
            src={image}
            alt={title}
            class="w-full h-full object-cover object-top"
            loading="lazy"
          />
        </div>
      </div>
    ) : (
      <div
        class="mx-auto w-4/5 h-3/4 mt-4 rounded-card border border-surface-800 bg-surface-900 flex flex-col items-center justify-center"
      >
        <!-- Browser Chrome Dots -->
        <div class="flex gap-1.5 self-start ml-4 mt-3">
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
        </div>
        <!-- Placeholder Text -->
        <span class="mt-8 text-xs text-surface-400">live preview on hover</span>
      </div>
    )}
  </div>

  <!-- Card Body -->
  <div class="p-5 flex flex-col flex-1">
    <!-- Metadata Row -->
    <div class="flex justify-start items-center mb-3">
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span
            class="px-3 py-1 rounded-pill text-xs bg-surface-900 text-surface-400 border border-surface-800"
            >
              {tag}
            </span>
          ))}
      </div>
    </div>

    <!-- Title -->
    <h3
      class="text-lg font-medium tracking-tight text-surface-200 leading-snug mb-2"
      >
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm leading-relaxed text-surface-600 mb-5 flex-1">
      {description}
    </p>

    <!-- Footer -->
    <div class="flex justify-between items-center mt-auto">
      <div class="flex gap-2">
        {caseStudyUrl && (
          <a
            href={caseStudyUrl}
            aria-label={`Read case study: ${title}`}
            class="px-3 py-1 rounded-input border border-surface-800 text-surface-400 hover:border-accent hover:text-accent transition-colors duration-base ease-expo-out text-sm"
          >
            Read
          </a>
        )}
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            aria-label={`${title} source code on GitHub`}
            class="px-3 py-1 rounded-input border border-surface-800 text-surface-400 hover:border-accent hover:text-accent transition-colors duration-base ease-expo-out text-sm"
          >
            Github
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            aria-label={`${title} live website`}
            class="px-3 py-1 rounded-input border border-surface-800 text-surface-400 hover:border-accent hover:text-accent transition-colors duration-base ease-expo-out text-sm"
          >
            Live site
          </a>
        )}
      </div>
    </div>
  </div>
</article>