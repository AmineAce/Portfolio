---
import type { CollectionEntry } from 'astro:content';

interface ProjectData {
  title: string;
  description?: string;
  tags?: string[];
  year?: number;
  featured?: boolean;
  liveUrl?: string;
  githubUrl?: string;
  order?: number;
  coverColor?: string;
  image?: string;
  slug?: string;
}

interface Props {
  entry?: CollectionEntry<'projects'> | ProjectData;
}

const { entry } = Astro.props;

const data: ProjectData = entry && 'data' in entry ? entry.data : (entry as ProjectData) || {};

const {
  title = '',
  description = '',
  tags = [],
  liveUrl,
  githubUrl,
  image,
} = data;

const slug = entry && 'id' in entry ? entry.id : (entry as ProjectData)?.slug || '';
const caseStudyUrl = slug ? `/work/${slug}` : undefined;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-card border border-surface-800 bg-surface-900 transition-all duration-base ease-expo-out hover:-translate-y-1 hover:border-accent/25 hover:shadow-[0_8px_32px_-8px] hover:shadow-accent/10"
>
  <div class="h-[180px]" style="background-color: var(--color-surface-950);">
    {image ? (
      <div class="w-full h-full p-3">
        <div class="w-full h-full rounded-card overflow-hidden bg-surface-950">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover object-top transition-transform duration-base ease-expo-out group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      </div>
    ) : (
      <div
        class="mx-auto w-4/5 h-3/4 mt-4 rounded-card border border-surface-800 bg-surface-900 flex flex-col items-center justify-center"
      >
        <div class="flex gap-1.5 self-start ml-4 mt-3">
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
          <div class="h-2 w-2 rounded-full bg-surface-700"></div>
        </div>
        <span class="mt-8 text-xs text-surface-500">Preview on hover</span>
      </div>
    )}
  </div>

  <div class="p-5 flex flex-col flex-1">
    <div class="flex justify-start items-center mb-3">
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span
            class="px-3 py-1 rounded-pill text-xs bg-surface-800 text-surface-400 border border-surface-700/50"
          >
            {tag}
          </span>
        ))}
      </div>
    </div>

    <h3
      class="text-lg font-medium tracking-tight text-surface-200 leading-snug mb-2 group-hover:text-surface-white transition-colors duration-micro"
    >
      {title}
    </h3>

    <p class="text-sm leading-relaxed text-surface-500 mb-5 flex-1">
      {description}
    </p>

    <div class="flex justify-between items-center mt-auto">
      <div class="flex gap-2">
        {caseStudyUrl && (
          <a
            href={caseStudyUrl}
            aria-label={`Read case study: ${title}`}
            class="px-3 py-1 rounded-input border border-surface-700/50 text-surface-400 hover:border-accent hover:text-accent hover:bg-accent/5 transition-all duration-base ease-expo-out text-sm"
          >
            Read
          </a>
        )}
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            aria-label={`${title} source code on GitHub`}
            class="px-3 py-1 rounded-input border border-surface-700/50 text-surface-400 hover:border-accent hover:text-accent hover:bg-accent/5 transition-all duration-base ease-expo-out text-sm"
          >
            Github
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            aria-label={`${title} live website`}
            class="px-3 py-1 rounded-input border border-surface-700/50 text-surface-400 hover:border-accent hover:text-accent hover:bg-accent/5 transition-all duration-base ease-expo-out text-sm"
          >
            Live site
          </a>
        )}
      </div>
    </div>
  </div>
</article>
