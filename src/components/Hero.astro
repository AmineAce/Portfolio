---
import VitruvianMan from '../components/VitruvianMan.astro';
---

<section id="hero" class="relative min-h-[80vh] flex flex-col justify-center px-6 pt-16 overflow-hidden">
  <!-- Ambient glow behind name -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
    <div class="w-[600px] h-[600px] bg-accent/5 rounded-full blur-3xl opacity-50"></div>
    </div>

    <div class="mx-auto w-full max-w-[1100px] relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- Left: Text -->
      <div>
          <h1
            class="font-serif italic text-surface-white text-7xl leading-tight tracking-tighter lg:text-8xl"
            style="animation: hero-scale-in 0.4s ease-out 0.15s both;"
          >
            Amine E.
          </h1>

          <div id="hero-tagline"
            class="font-sans text-surface-400 text-base leading-relaxed max-w-lg mb-10"
            style="animation: hero-fade-up 0.4s ease-out 0.35s both;"
        >
            Frontend developer. I build precise, performant interfaces.
        </div>

          <div class="mb-8 flex flex-wrap gap-3" style="animation: hero-fade-up 0.4s ease-out 0.5s both;">
            <a
              href="#work"
              class="rounded-input bg-white text-black font-medium px-6 py-3 text-sm border border-white transition-all duration-micro hover:bg-accent hover:text-white hover:border-accent active:scale-95"
            >
              View Work
            </a>
          <a
              href="#contact"
              class="rounded-input border border-surface-700 px-6 py-3 text-sm text-surface-300 transition-all duration-micro hover:border-accent hover:text-accent hover:bg-accent/5 active:scale-95"
            >
              Get in Touch
            </a>
          </div>
          </div>

      <!-- Right: Vitruvian Man Animation -->
      <div class="flex justify-center md:justify-end">
        <div class="w-full max-w-[360px]">
            <VitruvianMan />
          </div>
        </div>
      </div>

    <!-- Stats (full width below) -->
    <div class="flex gap-10 border-t border-surface-900 pt-10 mt-16" style="animation: hero-fade-up 0.4s ease-out 0.8s both;">
      <div style="animation: hero-fade-up 0.35s ease-out 0s both;">
        <span id="stat-projects" data-stat-to="3+" class="text-2xl font-medium tracking-tight text-surface-white">0+</span>
        <div class="mt-1 text-xs text-surface-500">Projects shipped</div>
      </div>
      <div style="animation: hero-fade-up 0.35s ease-out 0.08s both;">
        <span id="stat-lighthouse" data-stat-to="100" class="text-2xl font-medium tracking-tight text-surface-white">0</span>
        <div class="mt-1 text-xs text-surface-500">Lighthouse score</div>
      </div>
      <div style="animation: hero-fade-up 0.35s ease-out 0.16s both;">
        <span class="text-2xl font-medium tracking-tight text-surface-white">&#8734;</span>
        <div class="mt-1 text-xs text-surface-500">Attention to detail</div>
      </div>
    </div>
  </div>
</section>

<script>
  import { slotText } from "slot-text";

  const taglineEl = document.getElementById("hero-tagline");
  if (taglineEl) {
    const taglines = [
      "Frontend developer. I build precise, performant interfaces.",
      "Thoughtful interactions, clean code, real products.",
      "AI-assisted development, shipping the results.",
    ];
    const label = slotText(taglineEl, taglines[0], { duration: 240, stagger: 25, bounce: 0.5 });
    let i = 1;
    let paused = false;
    taglineEl.addEventListener("mouseenter", () => (paused = true));
    taglineEl.addEventListener("mouseleave", () => (paused = false));
    setInterval(() => {
      if (paused) return;
      label.set(taglines[i % taglines.length], { direction: "up" });
      i++;
    }, 5000);
  }

  (function () {
    const projects = document.getElementById("stat-projects");
      const lighthouse = document.getElementById("stat-lighthouse");
      if (!projects && !lighthouse) return;

        const statObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target;
          statObserver.unobserve(el);

              if (el === projects) {
              const p = slotText(el, "0+", { duration: 150, stagger: 30, bounce: 0.5, interrupt: false });
                [1, 2, 3].forEach((n, i) => {
                    setTimeout(() => p.set(n + "+", { direction: "up" }), (i + 1) * 200);
              });
                } else if (el === lighthouse) {
                const l = slotText(el, "0", { duration: 50, stagger: 10, bounce: 0.3, interrupt: false });
                const start = performance.now();

                  function phase1(now) {
                  const elapsed = now - start;
                  const t = Math.min(elapsed / 700, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    l.set(String(Math.round(82 * eased)), { direction: "up" });

                    if (t < 1) {
                      requestAnimationFrame(phase1);
                    } else {
                      const phase2Start = performance.now();
                      function phase2(now) {
                        const elapsed = now - phase2Start;
                        const t = Math.min(elapsed / 900, 1);
                      const eased = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
                      l.set(String(Math.round(82 + 15 * eased)), { direction: "up" });

                      if (t < 1) {
                        requestAnimationFrame(phase2);
                      } else {
                        setTimeout(() => l.set("98", { direction: "up", duration: 120, stagger: 25 }), 80);
                        setTimeout(() => l.set("99", { direction: "up", duration: 120, stagger: 25 }), 175);
                        setTimeout(() => l.set("100", { direction: "up", duration: 120, stagger: 25 }), 270);
                      }
                    }
                    requestAnimationFrame(phase2);
                  }
                }
                requestAnimationFrame(phase1);
              }
            }
          },
          { threshold: 0.5 },
        );
    if (projects) statObserver.observe(projects);
    if (lighthouse) statObserver.observe(lighthouse);

  })();
</script>
