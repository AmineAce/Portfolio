        { selector: '[data-hero-element="name"]', delay: 0.08, mode: 'immediate', y: 20, duration: 0.6 },
      { selector: '[data-hero-element="role"]', delay: 0.16, mode: 'immediate', y: 20, duration: 0.6 },
      { selector: '[data-hero-element="cta"]', delay: 0.24, mode: 'immediate', y: 20, duration: 0.6 },
      { selector: '[data-hero-element="stats"]', delay: 0.45, mode: 'immediate', y: 20, duration: 0.6 },
