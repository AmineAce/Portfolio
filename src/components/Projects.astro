---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<section id="work" class="max-w-[1100px] mx-auto px-6 py-24">
  <div class="flex justify-between items-end mb-16 reveal">
    <div>
      <p class="text-xs text-accent-ondark font-medium tracking-widest uppercase mb-3">
        Selected Work
      </p>
      <h2 class="text-4xl font-medium text-surface-200 tracking-tight">
        Projects
      </h2>
    </div>
    <p class="text-sm text-surface-600 max-w-xs text-right leading-relaxed">
      A focused set of work built with intention, shipped with care.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
    {sortedProjects.map((project) => (
      <div class="flex">
          <ProjectCard entry={project} />
      </div>
    ))}

    <div
      class="min-h-[220px] flex items-center justify-center rounded-card border border-dashed border-surface-800 bg-surface-900/30"
    >
      <span class="text-sm text-surface-500">More coming soon</span>
    </div>
  </div>


</section>
