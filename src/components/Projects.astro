---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));


---

<style>
  [data-reveal="card"] {
    opacity: 0;
    transform: translateY(24px);
  }
  [data-reveal="header"] {
    opacity: 0;
    transform: translateY(16px);
  }
</style>

<section id="work" class="max-w-[1100px] mx-auto px-6 py-24">
  <!-- Section Header -->
  <div data-reveal="header" class="flex justify-between items-end mb-16">
    <div>
      <p class="text-xs text-accent-ondark font-medium tracking-widest uppercase mb-3">
        Selected Work
      </p>
      <h2 class="text-4xl font-medium text-surface-200 tracking-tight">
        Projects
      </h2>
    </div>
    <p class="text-sm text-surface-600 max-w-xs text-right">
      A focused set of work built with intention, shipped with care.
    </p>
  </div>

  <!-- Project Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {sortedProjects.map((project) => (
        <ProjectCard entry={project} />
      ))}
  
      <!-- Coming Soon Card -->
    <div
      class="min-h-[200px] flex items-center justify-center rounded-card border border-dashed border-surface-800"
    >
        <span class="text-sm text-surface-400">More coming soon</span>
    </div>
    </div>

  <script>
    import { setupReveal } from '../utils/reveal';

    setupReveal({
      steps: [
        { selector: '[data-reveal="header"]', y: 16, duration: 0.5, mode: 'immediate' },
      { selector: '[data-reveal="card"]', y: 24, duration: 0.55, stagger: 0.1, threshold: 0.15 },
      ],
    }, 'projects');
  </script>
</section>