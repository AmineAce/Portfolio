---
import Base from '../layouts/Base.astro';
---

<Base title="404 - Page Not Found">
  <section class="flex min-h-[80vh] flex-col items-center justify-center px-6">
    <span class="text-accent text-8xl font-serif italic mb-4">404</span>
    <h1 class="text-2xl font-medium text-surface-200 mb-2">Page not found</h1>
    <p class="text-surface-400 text-sm mb-8 max-w-md text-center leading-relaxed">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="rounded-input bg-white text-black font-medium px-6 py-3 text-sm border border-white hover:border-accent hover:text-accent transition-colors duration-micro"
    >
      Go home
    </a>
  </section>
</Base>
